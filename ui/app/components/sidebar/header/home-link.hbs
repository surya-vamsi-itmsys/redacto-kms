<Hds::Interactive
  class="hds-side-nav__home-link"
  @current-when={{@current-when}}
  @models={{hds-link-to-models @model @models}}
  @query={{hds-link-to-query @query}}
  @replace={{@replace}}
  @route={{@route}}
  @isRouteExternal={{@isRouteExternal}}
  @href={{@href}}
  @isHrefExternal={{@isHrefExternal}}
  ...attributes
  aria-label={{this.ariaLabel}}
>
  {{#if @compactIcon}}
    <Icon @name={{@compactIcon}} @color={{@color}} @stretched={{true}} class="home-link-icon-compact" />
    <Icon @name={{@icon}} @color={{@color}} @stretched={{true}} class="home-link-icon-full" />
  {{else}}
    <Icon @name={{@icon}} @color={{@color}} @stretched={{true}} />
  {{/if}}
</Hds::Interactive>